includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    # phpstan-baseline.neon was copy-pasted from inteteam_crm's scaffold and still
    # references files that only exist there (CompanyController, InventoryItem,
    # etc.) -- without this, phpstan refuses to run at all. Found 2026-08-28
    # while setting up this environment for unrelated SSO auth work; the baseline
    # itself needs a proper regeneration against this repo's actual code, not
    # attempted here (out of scope).
    reportUnmatchedIgnoredErrors: false

    paths:
        - app
        - config
        - database
        - routes
    
    # Set analysis level (0-9, higher is stricter)
    level: 5
    
    # Exclude patterns
    excludePaths:
        - */cache/*
        - */node_modules/*
        - */vendor/*
        - */storage/*
        - */bootstrap/cache/*
    
    # Ignore specific errors (optional)
    ignoreErrors:
        # Ignore mixed types from third-party packages
        - '#Call to an undefined method Illuminate\\.*#'
        - '#Access to an undefined property Illuminate\\.*#'
    
    # Enable parallel processing
    parallel:
        maximumNumberOfProcesses: 4
        processTimeout: 300.0
